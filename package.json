{
  "name": "city-of-birds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "npm run observations:refresh && astro check && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "test": "npm run test:observations && playwright test",
    "images:optimize": "node scripts/optimize-images.mjs",
    "observations:refresh": "node scripts/fetch-observations.mjs",
    "test:observations": "node --test tests/observations.test.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.7",
    "@fontsource/dm-sans": "^5.2.8",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.162.0"
  }
}
