---
import { Image } from 'astro:assets';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import SpotCard from '../components/SpotCard.astro';
import sunbird from '../assets/sunbird.webp';
import { spots, heroPhoto } from '../data/spots';

const canonical = Astro.site ? new URL('/', Astro.site) : undefined;
const basics = [
  { icon: 'binoculars' as const, title: 'Give them space.', text: 'Use binoculars, not a closer approach. Keep well away from nests and resting birds.' },
  { icon: 'volume' as const, title: 'Let the birds do the talking.', text: 'Keep your voice low. Skip speakers, bird-call playback, and flash photography.' },
  { icon: 'feather' as const, title: 'Watch. Don’t feed.', text: 'Wild birds find their own food. Enjoy their natural behaviour without changing it.' },
  { icon: 'bag' as const, title: 'Leave it as you found it.', text: 'Carry your litter home, stay on public paths, and respect the people who live nearby.' },
];
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="theme-color" content="#5549DE" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content="Birding spots shared by City of Birds members in Udaipur and nearby. A handy starting point for new members planning a morning out." />
    <title>City of Birds — Our community’s birding spots</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content="City of Birds — Our community’s birding spots" />
    <meta property="og:description" content="New to the group? Find birding spots around Udaipur shared by fellow City of Birds members." />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={Astro.site ? new URL('/social-card.png', Astro.site) : '/social-card.png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="City of Birds. A little guide to birdwatching in Udaipur, in cream and indigo." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="hero-shell">
      <div class="site-header container">
        <a class="brand" href="/">
          <span class="brand-mark"><Icon name="bird" size={33} /></span>
          <span class="brand-name">City of Birds<span class="brand-descriptor">Our community’s birding spots</span></span>
        </a>
        <nav aria-label="Main navigation">
          <a href="#explore">Explore spots</a>
          <a href="#basics">Birding basics <Icon name="external" size={16} /></a>
        </nav>
      </div>
    </header>
    <main id="main">
      <div class="hero-shell">
        <section class="hero container" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="hero-location"><Icon name="pin" size={17} /> Udaipur, Rajasthan</p>
            <h1 id="hero-title">Find your next<br class="desktop-break" /> birding morning<br class="desktop-break" /> in Udaipur.</h1>
            <p class="hero-description">New to City of Birds? These are birding spots around Udaipur shared by fellow members. Pick a place for your next morning out.</p>
            <a class="button button-pink pressable" href="#explore">Explore birding spots <Icon name="arrow" size={23} /></a>
            <p class="hero-footnote"><Icon name="binoculars" size={18} /> Not sure where to start? Ask in the group.</p>
          </div>
          <figure class="hero-figure">
            <div class="photo-frame">
              <Image src={sunbird} alt="A small purple sunbird with a yellow underside perched beside a tree trunk in Udaipur" widths={[480, 768, 1024]} sizes="(max-width: 739px) 85vw, 430px" width={480} height={520} format="webp" loading="eager" fetchpriority="high" class="hero-photo" />
              <div class="hero-photo-caption"><span>A little neighbour.</span><span>Purple sunbird, Udaipur <Icon name="bird" size={23} /></span></div>
            </div>
            <figcaption><a href={heroPhoto.url} target="_blank" rel="noopener noreferrer">Photograph by {heroPhoto.author}</a> · <a href={heroPhoto.licenseUrl} target="_blank" rel="noopener noreferrer">{heroPhoto.license}</a></figcaption>
          </figure>
        </section>
      </div>

    <section class="explore-section container" id="explore" aria-labelledby="explore-title">
      <div class="section-intro">
        <div><h2 id="explore-title">Spots shared by our members.</h2><p>Choose somewhere nearby, or ask the group about a spot you haven’t visited yet.</p></div>
        <span class="local-note"><Icon name="pin" size={17} /> Udaipur & nearby</span>
      </div>
      <div class="discovery-controls" id="discovery-controls" hidden>
        <div class="filters" role="group" aria-label="Filter by habitat">
          <button class="filter-button pressable" type="button" data-filter="all" aria-pressed="true" aria-controls="spot-grid">All spots</button>
          <button class="filter-button pressable" type="button" data-filter="lake" aria-pressed="false" aria-controls="spot-grid"><Icon name="water" size={17} /> Lakes & wetlands</button>
          <button class="filter-button pressable" type="button" data-filter="woodland" aria-pressed="false" aria-controls="spot-grid"><Icon name="leaf" size={17} /> Parks & wooded areas</button>
        </div>
        <label class="search-field" for="spot-search"><Icon name="search" size={19} /><span class="sr-only">Search spots by name or area</span><input type="search" id="spot-search" placeholder="Search a spot or area" autocomplete="off" spellcheck="false" enterkeyhint="search" aria-controls="spot-grid" /></label>
      </div>
      <div class="results-line"><p id="result-count" role="status" aria-live="polite" aria-atomic="true">{spots.length} spots to explore</p><span>Go quietly. Look closely.</span></div>
      <div class="spot-grid" id="spot-grid">{spots.map(spot => <SpotCard spot={spot} />)}</div>
      <div class="empty-state" id="empty-state" hidden>
        <Icon name="search" size={34} />
        <h3>No spots found this time.</h3>
        <p>Try another name or area, or show all the spots again.</p>
        <button type="button" class="button button-indigo pressable" id="clear-filters">Clear filters</button>
      </div>
      <p class="explore-note"><Icon name="sun" size={18} /><span>Ask in the group for recent sightings or updates before heading out. Give birds space and keep to the paths.</span></p>
    </section>

    <section class="basics-section" id="basics" aria-labelledby="basics-title">
      <div class="basics-layout container">
        <div class="basics-intro"><Icon name="bird" size={60} /><h2 id="basics-title">We’re guests<br /> in their home.</h2><p>A few small things make a big difference to the birds you’ve come to see.</p></div>
        <div class="basics-grid">{basics.map(item => <div class="basic-item"><span class="basic-icon"><Icon name={item.icon} size={25} /></span><h3>{item.title}</h3><p>{item.text}</p></div>)}</div>
      </div>
    </section>

    </main>
    <footer class="site-footer container">
      <div class="footer-top"><a class="brand footer-brand" href="/"><span class="brand-mark"><Icon name="bird" size={30} /></span><span class="brand-name">City of Birds<span class="brand-descriptor">Our community’s birding spots</span></span></a><p>See you by the lake.</p><a class="back-top" href="#main">Back to top <span aria-hidden="true">↑</span></a></div>
      <div class="footer-bottom">
        <p>Shared by City of Birds members.<br />For our group’s next birding morning.</p>
        <a href="#credits" id="credits-fallback">About our group & photo credits</a>
        <button type="button" class="credits-toggle" id="credits-toggle" aria-controls="credits" aria-expanded="false" hidden>About our group & photo credits <Icon name="plus" size={15} class="credits-plus" /><Icon name="minus" size={15} class="credits-minus" /></button>
      </div>
      <section class="credits" id="credits" aria-label="About our group and photo credits">
        <div class="credits-body">
          <p>These spots were shared and visited by members of our City of Birds community in Udaipur. We’ve gathered them here to help new members find places to go birding, including Menar outside the city.</p>
          <p>Bird notes come from local observations. For recent sightings, help identifying a bird, or advice on your first visit, ask fellow members in the group.</p>
          <ul>
            <li><a href={heroPhoto.url} target="_blank" rel="noopener noreferrer">Purple sunbird by {heroPhoto.author}</a>, <a href={heroPhoto.licenseUrl} target="_blank" rel="noopener noreferrer">{heroPhoto.license}</a>.</li>
            {spots.map(spot => spot.photo && <li><a href={spot.photo.url} target="_blank" rel="noopener noreferrer">{spot.photo.label} by {spot.photo.author}</a>, <a href={spot.photo.licenseUrl} target="_blank" rel="noopener noreferrer">{spot.photo.license}</a>.</li>)}
            {spots.map(spot => spot.photoNote && <li>{spot.name}: {spot.photoNote}</li>)}
          </ul>
          <p>Photographs are resized and cropped for display. Please respect the linked photo licences; ShareAlike applies where specified. Menar’s photo shows a spoonbill observed at the lake. Fonts: Barlow Condensed and DM Sans, under the SIL Open Font License.</p>
        </div>
      </section>
    </footer>
    <script src="../scripts/discovery.ts"></script>
  </body>
</html>
